{
  "name": "scalpsphere-admin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API for the ScalpSphere admin dashboard (demo configuration).",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "seed": "node scripts/seed-demo.js",
    "seed:reset": "node scripts/seed-demo.js --reset",
    "admin:create": "node scripts/create-admin.js",
    "admin:set-password": "node scripts/set-admin-password.js",
    "admin:revoke-sessions": "node scripts/revoke-sessions.js",
    "customer:credentials": "node scripts/customer-credentials.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:mysql": "cross-env DB_DRIVER=mysql node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "smoke:db": "node scripts/smoke-test.js",
    "check": "node scripts/check-env.js && node scripts/check-migrations.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
