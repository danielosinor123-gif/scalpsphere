# ---------------------------------------------------------------------------
# ScalpSphere admin backend — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# `.env.example` must never contain a real secret.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
# Bind address. Use 127.0.0.1 locally; 0.0.0.0 only behind a proxy/firewall.
HOST=127.0.0.1
# Public origin of this API, no trailing slash (used for docs/logs/CORS echo).
API_ORIGIN=http://localhost:4000

# ---------------------------------------------------------------------------
# CORS / origins
# Comma-separated explicit allow-list. REQUIRED in production.
# Do NOT use "*" — the API authenticates with cookies.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5173

# Set to "true"/"loopback"/"1"/a hop count when behind a reverse proxy so that
# req.ip is the client IP (needed for rate limiting) instead of the proxy IP.
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# mysql  -> production / real database (default)
# memory -> in-process store, ONLY allowed when NODE_ENV=test
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scalpsphere_app
DB_PASSWORD=
DB_NAME=scalpsphere
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
# Set to true when the MySQL server enforces TLS (managed DBs usually do).
DB_SSL=false
# Optional charset/collation override
DB_CHARSET=utf8mb4

# --- Auth / sessions -------------------------------------------------------
# Required. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=scalpsphere
JWT_AUDIENCE=scalpsphere-admin
# Access token lifetime (jsonwebtoken timespan, e.g. 15m, 1h)
JWT_ACCESS_TTL=15m
# Opaque refresh-token lifetime in days (stored hashed in admin_sessions)
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor. 12 is a sane default; raise on fast hardware.
BCRYPT_ROUNDS=12
# Maximum failed logins before the account is temporarily locked
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Cookies ---------------------------------------------------------------
# Send Secure cookies. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
# Cookie domain (optional). Leave empty for host-only cookies.
COOKIE_DOMAIN=
# strict | lax | none. "none" requires COOKIE_SECURE=true.
COOKIE_SAMESITE=strict
# Path prefix for the API (used for cookie paths).
API_BASE_PATH=/api/v1

# --- Rate limiting ---------------------------------------------------------
# Auth endpoints (per identifier + IP). Only FAILED attempts are counted.
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# All other API routes (per IP). 3000/15min = 200/min: an admin dashboard fires
# several API calls per screen, so do not set this near a few hundred.
RATE_LIMIT_API_MAX=3000
RATE_LIMIT_API_WINDOW_MS=900000
# Write routes (POST/PATCH/PUT/DELETE, per IP)
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=900000

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=json

# --- Demo data guards ------------------------------------------------------
# The seed command must be run intentionally and only writes synthetic records.
# Seeding into a production database requires this explicit opt-in.
SEED_ALLOW_IN_PRODUCTION=false
